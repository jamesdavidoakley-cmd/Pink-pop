{
  "name": "grit",
  "private": true,
  "version": "1.0.0",
  "description": "GRIT \u2014 a haulage game that teaches grip and friction through the controls.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:single": "npm run build && node scripts/build-single.mjs",
    "check": "npm run typecheck && npm run test && npm run build",
    "smoke": "node scripts/smoke.mjs http://127.0.0.1:5180/ .",
    "tour": "node scripts/tour.mjs http://127.0.0.1:5180/ .",
    "check:offline": "npm run build:single && node scripts/offline-check.mjs \"file://$PWD/dist-single/grit.html\" /tmp/grit-offline.png && node scripts/sw-check.mjs \"$PWD/dist\""
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.49.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
