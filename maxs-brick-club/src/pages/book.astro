---
import Base from '../layouts/Base.astro';
import { saturdayLabels } from '../scripts/saturdays';

/**
 * Static skeleton for the default state (Brick Club, first Saturday, 1 builder).
 * src/scripts/book.ts owns the state and re-renders everything on load, including
 * the six Saturdays (computed in the browser so they are never stale).  The
 * build-time rows below are only a no-JS fallback; both sides use the same
 * saturdays.ts helper so the labels never change after hydration.
 */
const SPOTS_SEED = [7, 3, 11, 1, 9, 6];
const dates = saturdayLabels().map((label, i) => {
  const spots = SPOTS_SEED[i];
  const low = spots <= 3;
  return { label, low, pill: low ? `${spots} left!` : `${spots} spots` };
});
---
<Base title="Book a spot">
  <!-- Hero -->
  <section class="hero">
    <div class="eyebrow">ONLINE BOOKING · £5</div>
    <h1 class="h1">Book a spot</h1>
    <p class="book-lead">Pick a club, pick a Saturday, pay £5. Takes about 30 seconds. Cancel free up to 9am on the day.</p>
  </section>

  <!-- Booking form (hidden once booked) -->
  <section class="booking" data-booking>
    <div class="steps">
      <div class="card">
        <h2 class="label card__label">1 · WHICH CLUB?</h2>
        <div class="tiles">
          <button type="button" class="tile tile--mini" data-pick-club="mini" aria-pressed="false">
            <span class="tile__name">Mini Bricks</span>
            <span class="tile__sub">Ages 2–4 · 9:30</span>
          </button>
          <button type="button" class="tile tile--club is-selected" data-pick-club="club" aria-pressed="true">
            <span class="tile__name">Brick Club</span>
            <span class="tile__sub">Ages 4–7 · 10:30</span>
          </button>
        </div>
      </div>

      <div class="card">
        <h2 class="label card__label">2 · WHICH SATURDAY?</h2>
        <div class="dates" data-dates>
          {dates.map((d, i) => (
            <button type="button" class:list={['date', { 'is-selected': i === 0 }]} data-date-index={i} aria-pressed={i === 0 ? 'true' : 'false'}>
              <span class="date__label">{d.label}</span>
              <span class:list={['pill', { 'pill--low': d.low }]}>{d.pill}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="card">
        <h2 class="label card__label">3 · HOW MANY BUILDERS?</h2>
        <div class="stepper">
          <button type="button" class="stepper__btn" data-kids-minus aria-label="Fewer builders">−</button>
          <span class="stepper__count" data-kids aria-live="polite">1</span>
          <button type="button" class="stepper__btn" data-kids-plus aria-label="More builders">+</button>
          <span class="stepper__note">Second child £4</span>
        </div>
      </div>
    </div>

    <form class="summary" data-book-form novalidate>
      <h2 class="summary__title">Your booking</h2>
      <div class="summary__rows">
        <div class="summary__row"><span class="summary__key">Club</span><span class="summary__val" data-sum-club>Max's Brick Club</span></div>
        <div class="summary__row"><span class="summary__key">Time</span><span data-sum-time>10:30–11:30</span></div>
        <div class="summary__row"><span class="summary__key">Date</span><span class="summary__val" data-sum-date>{dates[0].label}</span></div>
        <div class="summary__row"><span class="summary__key">Builders</span><span data-sum-kids>1</span></div>
      </div>
      <div class="summary__total">
        <span class="summary__total-label">Total</span>
        <span class="summary__price" data-total>£5</span>
      </div>
      <div class="summary__inputs">
        <input class="field" type="text" name="name" placeholder="Grown-up's name" autocomplete="name" />
        <input class="field" type="email" name="email" placeholder="Email for the confirmation" autocomplete="email" />
        <input class="field" type="text" name="builders" placeholder="Builder's first name(s) & age(s)" />
      </div>
      <button type="submit" class="pay" data-confirm>PAY <span data-pay-total>£5</span> &amp; BOOK</button>
      <p class="summary__note">Secure card payment. You'll get a confirmation email and a reminder on Friday.</p>
    </form>
  </section>

  <!-- Success state -->
  <section class="done" data-success hidden>
    <div class="done__card">
      <h2 class="done__title">You're in!</h2>
      <p class="done__copy"><span data-done-kids>1</span> builder(s) booked for <span data-done-club>Max's Brick Club</span> on <span data-done-date>{dates[0].label}</span>. Confirmation's on its way. Doors open 10 minutes before. Bring nothing but enthusiasm.</p>
      <div class="done__actions">
        <button type="button" class="done__btn done__btn--yellow" data-book-another>Book another</button>
        <a class="done__btn done__btn--white" href="/">Back home</a>
      </div>
    </div>
  </section>
</Base>

<script>import '../scripts/book.ts';</script>

<style>
  /* Hero */
  .book-lead { font-size: 18px; font-weight: 700; line-height: 1.45; max-width: 560px; margin: 0; }

  /* Booking grid */
  .booking {
    max-width: var(--content); margin: 0 auto; padding: 0 var(--gutter) 72px;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 28px; align-items: start;
  }
  .booking[hidden] { display: none; }
  .steps { display: flex; flex-direction: column; gap: 28px; }
  .card { background: var(--white); color: var(--ink); border-radius: 14px; padding: 30px; }
  .card__label { margin: 0 0 12px; }

  /* 1 · club tiles */
  .tiles { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .tile {
    display: block; width: 100%; text-align: left; border-radius: 10px; padding: 18px; cursor: pointer;
    background: var(--white); color: var(--ink); border: 3px solid;
  }
  .tile--mini { border-color: var(--cyan); }
  .tile--club { border-color: var(--red); }
  .tile--mini.is-selected { background: var(--cyan); color: var(--white); }
  .tile--club.is-selected { background: var(--red); color: var(--white); }
  .tile__name { display: block; font-family: var(--display); font-size: 22px; line-height: 1; }
  .tile__sub { display: block; font-weight: 800; font-size: 14px; margin-top: 4px; }

  /* 2 · dates (rows are re-rendered by book.ts, so the row rules are :global) */
  .dates { display: flex; flex-direction: column; gap: 8px; }
  .dates :global(.date) {
    display: flex; justify-content: space-between; align-items: center; width: 100%; text-align: left;
    border-radius: 10px; padding: 14px 16px; cursor: pointer; border: 3px solid var(--border-grey); background: var(--white); color: var(--ink);
  }
  .dates :global(.date.is-selected) { border-color: var(--ink); background: var(--yellow); }
  .dates :global(.date__label) { font-weight: 900; font-size: 16px; }
  .dates :global(.pill) { font-weight: 800; font-size: 13px; padding: 4px 10px; border-radius: 999px; background: var(--green); color: var(--white); }
  .dates :global(.pill--low) { background: var(--red); }

  /* 3 · builders stepper */
  .stepper { display: flex; align-items: center; gap: 16px; }
  .stepper__btn {
    width: 44px; height: 44px; border-radius: 10px; background: var(--yellow); color: var(--ink);
    display: flex; align-items: center; justify-content: center; font-weight: 900; font-size: 22px; cursor: pointer; flex: none;
  }
  .stepper__count { font-family: var(--display); font-size: 36px; width: 40px; text-align: center; }
  .stepper__note { font-weight: 700; color: var(--muted); }

  /* Sticky summary */
  .summary { background: var(--ink); color: var(--white); border-radius: 14px; padding: 36px; position: sticky; top: 90px; }
  .summary__title { font-family: var(--display); font-weight: 400; font-size: 34px; color: var(--yellow); line-height: 1; margin: 0 0 20px; }
  .summary__rows { display: flex; flex-direction: column; gap: 10px; font-weight: 700; font-size: 17px; }
  .summary__row { display: flex; justify-content: space-between; gap: 12px; }
  .summary__key { opacity: .7; }
  .summary__val { text-align: right; }
  .summary__total {
    border-top: 2px solid rgba(255, 255, 255, .2); margin: 20px 0; padding-top: 20px;
    display: flex; justify-content: space-between; align-items: baseline;
  }
  .summary__total-label { font-weight: 900; font-size: 18px; }
  .summary__price { font-family: var(--display); font-size: 44px; color: var(--yellow); }
  .summary__inputs { display: flex; flex-direction: column; gap: 10px; margin-bottom: 14px; }
  .field {
    background: var(--white); border: 0; border-radius: 8px; padding: 13px 16px;
    font-weight: 700; font-family: inherit; font-size: 15px; width: 100%;
  }
  .pay {
    display: block; width: 100%; background: var(--red); color: var(--white); font-weight: 900; font-size: 18px;
    padding: 16px; border-radius: 10px; text-align: center; cursor: pointer; box-shadow: 0 6px 0 var(--red-shadow);
  }
  .pay:hover { transform: translateY(-2px); }
  .summary__note { margin: 14px 0 0; font-size: 13px; font-weight: 700; opacity: .6; line-height: 1.5; }

  /* Success */
  .done { max-width: var(--content); margin: 0 auto; padding: 0 var(--gutter) 72px; }
  .done[hidden] { display: none; }
  .done__card { background: var(--green); color: var(--white); border-radius: 14px; padding: clamp(32px, 5vw, 56px); text-align: center; }
  .done__title { font-family: var(--display); font-weight: 400; font-size: clamp(44px, 6vw, 72px); line-height: 1; margin: 0; }
  .done__copy { font-size: 19px; font-weight: 700; margin: 16px auto 0; max-width: 520px; line-height: 1.45; }
  .done__actions { display: flex; gap: 12px; justify-content: center; margin-top: 28px; flex-wrap: wrap; }
  .done__btn { display: inline-block; font-weight: 900; padding: 14px 24px; border-radius: 10px; cursor: pointer; text-decoration: none; }
  .done__btn--yellow { background: var(--yellow); color: var(--ink); }
  .done__btn--white { background: var(--white); color: var(--green); }
  .done__btn--white:hover { color: var(--green); }

  @media (prefers-reduced-motion: reduce) {
    .pay:hover { transform: none; }
  }
</style>
