{
  "name": "max-and-the-star-fossils",
  "private": true,
  "version": "0.2.0",
  "description": "A joyful 3D collect-a-thon platformer where a young blue T-Rex earns Star Fossils by solving real KS2 science, maths and engineering challenges.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate.mjs",
    "test": "vitest run",
    "test:ai": "vitest run tests/ai-sim",
    "test:smoke": "playwright test",
    "ci": "npm run typecheck && npm run validate && npm run test && npm run build"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "postprocessing": "^6.36.4",
    "three": "^0.170.0",
    "three-mesh-bvh": "^0.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "@types/three": "^0.170.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
