{
  "name": "king-hunt",
  "private": true,
  "version": "0.1.0",
  "description": "King Hunt: a 3D chess game that teaches a young player to attack.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ci": "npm run typecheck && npm run test && npm run build",
    "postinstall": "node scripts/copy-engine.mjs",
    "prebuild": "node scripts/copy-engine.mjs",
    "electron": "electron .",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "postprocessing": "^6.36.4",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "^0.170.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "stockfish": "^17.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "main": "electron/main.cjs"
}
