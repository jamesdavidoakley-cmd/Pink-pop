{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dialogue.schema.json",
  "title": "Scripted dialogue scene",
  "type": "object",
  "required": ["id", "lines"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string" },
    "once": { "type": "boolean" },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["speaker", "text"],
        "properties": {
          "speaker": { "type": "string" },
          "text": { "type": "string", "minLength": 1 },
          "emote": { "enum": ["neutral", "happy", "sad", "surprised", "angry", "smug"] },
          "delay": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}
