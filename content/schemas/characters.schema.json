{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "characters.schema.json",
  "title": "Character registry",
  "type": "object",
  "patternProperties": {
    "^\\$schema$": { "type": "string" },
    "^[a-z][a-z0-9_]*$": {
      "type": "object",
      "required": ["name", "role", "active", "rig", "colors", "voice", "subtitleColor"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "role": { "enum": ["hero", "companion", "villain", "boss", "miniboss", "prop"] },
        "active": { "type": "boolean" },
        "rig": { "enum": ["trex", "human", "dog", "cogling", "drone"] },
        "scale": { "type": "number", "minimum": 0.1 },
        "colors": {
          "type": "object",
          "required": ["body", "belly", "accent"],
          "additionalProperties": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
        },
        "subtitleColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "voice": {
          "type": "object",
          "required": ["rate", "pitch"],
          "properties": {
            "rate": { "type": "number", "minimum": 0.5, "maximum": 2 },
            "pitch": { "type": "number", "minimum": 0, "maximum": 2 },
            "volume": { "type": "number", "minimum": 0, "maximum": 1 },
            "langPref": { "type": "string" },
            "namePref": { "type": "array", "items": { "type": "string" } }
          }
        },
        "signature": { "type": "string" }
      }
    }
  },
  "additionalProperties": false
}
