{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "movesets.schema.json",
  "title": "Shared boss moveset — personality-neutral toolkit",
  "type": "object",
  "required": ["id", "moves"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string" },
    "moves": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "tags", "baseWeight", "duration"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "tags": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["strike", "advance", "retreat", "block", "reposition", "feint", "taunt", "wait", "special", "ranged"] }
          },
          "baseWeight": { "type": "number", "minimum": 0 },
          "duration": { "type": "number", "minimum": 0.1 },
          "telegraph": { "type": "number", "minimum": 0 },
          "recovery": { "type": "number", "minimum": 0 },
          "cooldown": { "type": "number", "minimum": 0 },
          "threat": { "type": "number", "minimum": 0 },
          "range": { "enum": ["near", "mid", "far", "any"] },
          "damage": { "type": "number", "minimum": 0 },
          "motion": {
            "type": "object",
            "properties": {
              "kind": { "enum": ["lunge", "hold", "strafe", "retreat", "approach", "leap", "vanishStep"] },
              "speed": { "type": "number" }
            }
          },
          "hit": {
            "type": "object",
            "properties": {
              "shape": { "enum": ["arc", "ring", "line"] },
              "radius": { "type": "number" },
              "arc": { "type": "number" },
              "from": { "type": "number" },
              "to": { "type": "number" }
            }
          },
          "projectile": {
            "type": "object",
            "properties": { "speed": { "type": "number" }, "damage": { "type": "number" }, "count": { "type": "integer" } }
          },
          "stance": { "enum": ["block", "none"] },
          "bark": { "type": "string" }
        }
      }
    }
  }
}
